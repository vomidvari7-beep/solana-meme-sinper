[Unit]
Description=SolanaMemeSniper headless daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sms
Group=sms
WorkingDirectory=/opt/sms
EnvironmentFile=-/etc/sms/sms.env
ExecStart=/usr/bin/node /opt/sms/src/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
